# YouTube Data API v3
VITE_YOUTUBE_API_KEY=your_youtube_api_key_here
VITE_YOUTUBE_PLAYLIST_ID=your_default_playlist_id_here

# SheetDB (optional)
VITE_SHEETDB_API_URL=your_sheetdb_url_here

# YouTube OAuth (server-side only, not needed for basic playback)
YOUTUBE_CLIENT_ID=your_oauth_client_id_here
YOUTUBE_CLIENT_SECRET=your_oauth_client_secret_here
YOUTUBE_REFRESH_TOKEN=your_refresh_token_here

# Access PINs — also add these to Vercel environment variables
VITE_HOST_PIN=your_host_pin_here
VITE_GUEST_PIN=your_guest_pin_here
