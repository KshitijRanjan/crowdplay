# YouTube Data API v3
VITE_YOUTUBE_API_KEY=your_youtube_api_key_here

# Admin PIN — protects the /admin panel (choose something only you know)
VITE_ADMIN_PIN=your_admin_pin_here

# EmailJS — for host access request notifications
# Sign up at https://www.emailjs.com, create a service + template, paste IDs below
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
