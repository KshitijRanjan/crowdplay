rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function roomRole(roomCode) {
      return get(/databases/$(database)/documents/rooms/$(roomCode)/roles/$(request.auth.uid)).data.role;
    }

    function isRoomHost(roomCode) {
      return isAuthenticated() && roomRole(roomCode) == 'host';
    }

    function onlyUpvoting() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes']);
    }

    function onlyBumpingActivity() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActivityAt']);
    }

    // ── Host access requests ──────────────────────────────────────────────────
    // Anyone authenticated can submit or read; admin approves from client
    match /hostRequests/{email} {
      allow read, write: if isAuthenticated();
    }

    // ── Approved hosts ────────────────────────────────────────────────────────
    // Any authenticated user can read (login check); admin writes from client
    match /approvedHosts/{email} {
      allow read, write: if isAuthenticated();
    }

    // ── Rooms ─────────────────────────────────────────────────────────────────
    match /rooms/{roomCode} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
                    && exists(/databases/$(database)/documents/approvedHosts/$(request.auth.token.email));
      allow update: if isAuthenticated() && (
                      resource.data.hostUid == request.auth.uid ||
                      onlyBumpingActivity()
                    );
      allow delete: if false;

      // Queue subcollection
      match /queue/{songId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
                      && request.resource.data.keys().hasAll(['videoId', 'title', 'addedBy', 'addedAt', 'status'])
                      && request.resource.data.status == 'pending';
        allow update: if isRoomHost(roomCode) || (isAuthenticated() && onlyUpvoting());
        allow delete: if isRoomHost(roomCode);
      }

      // Roles subcollection — write-once per uid
      match /roles/{uid} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
                      && request.auth.uid == uid
                      && !exists(/databases/$(database)/documents/rooms/$(roomCode)/roles/$(uid));
        allow update, delete: if false;
      }
    }

    // ── Legacy top-level roles (backwards compat) ─────────────────────────────
    match /roles/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow create: if isAuthenticated()
                    && request.auth.uid == uid
                    && !exists(/databases/$(database)/documents/roles/$(uid));
      allow update, delete: if false;
    }

    // ── Legacy top-level queue (read-only; new writes go to room subcollection) ─
    match /queue/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ── Deny everything else ──────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
